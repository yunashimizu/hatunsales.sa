{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/favicon.svg",
          "/apple-touch-icon.png",
          "/main-*.js",
          "/polyfills-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "pantallas",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    },
    {
      "name": "recursos",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/fonts/**",
          "/icons/**",
          "/assets/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/uploads/**",
    "!/media/**"
  ]
}
